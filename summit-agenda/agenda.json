 "summits": {
  "nola": {
   "name": "2027 Winter Summit",
   "city": "InterContinental New Orleans",
   "dates": "January 11–14, 2027",
   "gs": {
    "label": "General Sessions",
    "day": "Tuesday",
    "date": "Tuesday, January 12, 2027",
    "room": "La Salle A/B",
    "sessions": [
     {
      "start": "9:00 AM",
      "end": "9:20 AM",
      "kind": "Welcome",
      "title": "Laissez les Bons Temps Rouler: What's Next for MISMO in 2027",
      "desc": "New year, new ideas, New Orleans! Let the good times (and the standards) roll as Brian Vieaux and Amy Moses kick off the first industry conference of 2027. They’ll unveil the priorities that will guide MISMO’s work all year long and share how you can help shape what comes next.",
      "sponsor": "",
      "brk": false,
      "people": [
       {
        "name": "Amy Moses",
        "title": "VP, Strategic Growth",
        "company": "MISMO",
        "role": "Host",
        "photo": ""
       },
       {
        "name": "Brian Vieaux",
        "title": "President",
        "company": "MISMO",
        "role": "Speaker",
        "photo": ""
       }
      ]
     },
     {
      "start": "9:20 AM",
      "end": "9:50 AM",
      "kind": "Fireside Chat",
      "title": "Quantum Computing: The Mortgage Industry's Next Big Disruption?",
      "desc": "It sounds like science fiction, but it's closer than you think. Brian Vieaux leads a conversation with Dr. Daniel Conway as he unpacks what quantum computing means for data security and the future of lending.",
      "sponsor": "Crittora",
      "brk": false,
      "people": [
       {
        "name": "Brian Vieaux",
        "title": "President",
        "company": "MISMO",
        "role": "Moderator",
        "photo": ""
       }
      ]
     },
     {
      "start": "9:50 AM",
      "end": "10:20 AM",
      "kind": "Presentation",
      "title": "The New Rules of AI Governance",
      "desc": "With state examinations and updated GSE requirements arriving in 2027, the expectations are getting real. Cathy Puente of Newrez, Mike Bray of CSBS and Linna Zhu of the Urban Institute break down what's changing, what regulators will look for, what the latest research reveals about AI governance in mortgage lending, and how lenders are getting ready.",
      "sponsor": "",
      "brk": false,
      "people": [
       {
        "name": "Mike Bray",
        "title": "Senior Director, Nonbank Supervision & Enforcement",
        "company": "Conference of State Bank Supervisors",
        "role": "Speaker",
        "photo": ""
       }
      ]
     },
     {
      "start": "10:40 AM",
      "end": "11:05 AM",
      "kind": "Presentation",
      "title": "A Conversation with the CSBS Chair",
      "desc": "MISMO's Amy Moses sits down with Rhoshunda Kelly, Commissioner of the Mississippi Department of Banking and Consumer Finance, to discuss her department's plans for rolling out AI governance reviews. As Chair of the Conference of State Bank Supervisors, she'll also share the state system's progress on testing and implementing the Mortgage Compliance Dataset.",
      "sponsor": "",
      "brk": false,
      "people": [
       {
        "name": "Amy Moses",
        "title": "VP, Strategic Growth",
        "company": "MISMO",
        "role": "Speaker",
        "photo": ""
       }
      ]
     },
     {
      "start": "11:05 AM",
      "end": "11:30 AM",
      "kind": "Presentation",
      "title": "GSE UMPD Updates",
      "desc": "GSE Uniform Mortgage Data Program (UMPD) Updates\n\nJoin this can’t‑miss session to hear the latest updates from the GSEs on the Uniform Mortgage Data Program (UMDP), including developments related to:\n• Desktop Underwriter® and Loan Product Advisor® data specifications\n• The Uniform Appraisal Dataset (UAD) Broad Production Period\n• The Uniform Closing Dataset (UCD) v2.0 Specification Mandate\n• The Uniform Loan Delivery Dataset (ULDD) Update",
      "sponsor": "",
      "brk": false,
      "people": [
       {
        "name": "Noah Israel",
        "title": "",
        "company": "",
        "role": "Speaker",
        "photo": ""
       },
       {
        "name": "Colleen Flaxington",
        "title": "Director of Industry Standards",
        "company": "Freddie Mac",
        "role": "Speaker",
        "photo": ""
       },
       {
        "name": "Sunil Vaid",
        "title": "",
        "company": "",
        "role": "Speaker",
        "photo": ""
       },
       {
        "name": "James Babalitis",
        "title": "Senior Manager, Product Management, Enterprise Data",
        "company": "Fannie Mae",
        "role": "Speaker",
        "photo": ""
       }
      ]
     },
     {
      "start": "12:05 PM",
      "end": "1:30 PM",
      "kind": "Lunch",
      "title": "Lunch",
      "desc": "Enjoy lunch on your own in the area around the hotel! The InterContinental sits in the Central Business District, a few blocks from some of the best cooking in the country. See lunch recommendations here - https://www.mismo.org/events/hotel.",
      "sponsor": "",
      "brk": true,
      "people": []
     }
